# Stage 1: Install dependencies
FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

# Stage 2: Clean runtime
FROM node:20-alpine

WORKDIR /app
COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY API_node.js ./

EXPOSE 3000
CMD ["node", "API_node.js"]
