# Stage 1: Build the binary
FROM golang:1.23-alpine AS builder

WORKDIR /app
COPY API_go.go .

# Compile a static binary without debug info to make it tiny
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o server API_go.go

# Stage 2: Minimal runtime
FROM alpine:3.20

WORKDIR /app
COPY --from=builder /app/server .

EXPOSE 8080
CMD ["./server"]